# Единое форматирование файлов репозитория (https://editorconfig.org)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# В Markdown два пробела в конце строки — перенос строки
trim_trailing_whitespace = false
